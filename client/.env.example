# Copia este archivo como .env y llena los valores.

# URL de la API. Vacío en desarrollo (Vite hace proxy de /api al server).
VITE_API_URL=

# WhatsApp del negocio, solo dígitos con lada de país. Ej: 5215512345678
VITE_WHATSAPP_NUMBER=

# --- Medición ---
# GA4: ID de medición (G-XXXXXXX). Vacío = no se carga Google Analytics.
VITE_GA4_ID=
# Meta Pixel: ID numérico del píxel. Vacío = no se carga el Pixel.
VITE_META_PIXEL_ID=
