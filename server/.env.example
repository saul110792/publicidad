# Copia este archivo como .env y llena los valores.
NODE_ENV=development
# Puerto local de la API. En Render se usa PORT (lo asigna Render).
API_PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CLIENT_URL=http://localhost:5173

# PostgreSQL (se usa desde la Fase 2)
DATABASE_URL=postgres://usuario:password@localhost:5432/publicidad

# Envío a domicilio en centavos (ej. 15000 = $150). Vacío = "por confirmar".
SHIPPING_COST=

# Subida de archivos de diseño (Cloudinary). Vacío = el cliente manda el archivo por WhatsApp.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Fases siguientes ---
# JWT_SECRET=
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
