# Copia este archivo como .env y llena los valores.
NODE_ENV=development
# Puerto local de la API. En Render se usa PORT (lo asigna Render).
API_PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CLIENT_URL=http://localhost:5173

# PostgreSQL (se usa desde la Fase 2)
DATABASE_URL=postgres://usuario:password@localhost:5432/publicidad

# Envío a domicilio en centavos (ej. 15000 = $150). Vacío = "por confirmar".
SHIPPING_COST=

# Subida de archivos de diseño (Cloudinary). Vacío = el cliente manda el archivo por WhatsApp.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Pagos ---
# mercadopago | mock (pago simulado, solo en desarrollo). Vacío = mercadopago si hay token;
# sin token, el pago con tarjeta se coordina por WhatsApp.
PAYMENT_PROVIDER=
# Access token de Mercado Pago (usa el de prueba mientras desarrollas).
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (panel de Mercado Pago > Tus integraciones > Webhooks).
MP_WEBHOOK_SECRET=
# URL pública https de esta API, para recibir los webhooks. Ej: https://api.tudominio.com
API_PUBLIC_URL=

# --- Fases siguientes ---
# JWT_SECRET=
